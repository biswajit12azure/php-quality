{
    "name": "training/php-quality-training",
    "description": "PHP Quality and Testing Training Project",
    "type": "project",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "codeception/codeception": "^5.3",
        "codeception/module-phpbrowser": "^3.0",
        "codeception/module-asserts": "^3.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src public tests -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
        "format": "php-cs-fixer fix --dry-run --diff",
        "format:fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "test:unit": "phpunit tests/Unit",
        "test:functional": "phpunit tests/Functional",
        "test:acceptance": "codecept run acceptance"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}